# a package cache: excluded by THIS repository's rule, not by the tool's habit of
# leaving a .gitignore containing `*` inside its own cache directory
.uvcache/
verify/
__pycache__/
*.pyc

# an auditor's scratch, not part of the record
.audit/
.mutations/
.probe/

# the suites own output, rewritten by every run
standing.log
standing.prev.log

# the suite's record of its LAST run: rewritten by every run, carries this tree's
# digests. A tracked file that a run rewrites shows up as a modification nobody made,
# and committing it publishes one machine's digests as source. Absent on a fresh
# clone, and `run_all.sh` says so instead of comparing against nothing.
repro/fresco/regression.json

# the profiling step's snapshots, rewritten by every run under a minted name
repro/fresco/.profile_*

# the runner's own heartbeat: appended to by every run, read by the probe that turns
# silence into a red line. Untracked for the same reason the record above is -- it says
# when a machine ran, which is not source -- and absent on a fresh clone is a case the
# probe has: no stamp is red, not quiet.
repro/fresco/tick.log
